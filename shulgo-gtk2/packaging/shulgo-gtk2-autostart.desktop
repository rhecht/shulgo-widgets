[Desktop Entry]
Type=Application
Name=ShulGo
GenericName=Minyan finder
Comment=The next minyan near you in the tray, with today's zmanim
Exec=shulgo-gtk2
Icon=shulgo
Terminal=false
Keywords=minyan;shul;synagogue;zmanim;davening;
StartupNotify=false
TryExec=/usr/bin/shulgo-gtk2
X-GNOME-Autostart-enabled=true
