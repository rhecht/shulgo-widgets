{
  "name": "shulgo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ShulGo in the macOS menu bar (and the Windows tray): the next minyan near you, with events, mikvaos and zmanim.",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prestart": "npm run sync-core",
    "start": "electron .",
    "predev": "npm run sync-core",
    "dev": "electron . --show --dev",
    "prepack": "npm run sync-core",
    "pack": "electron-builder --dir",
    "predist": "npm run sync-core",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.shulgo.desktop",
    "productName": "ShulGo",
    "files": [
      "src/**/*",
      "assets/**/*",
      "shulgo-core/**/*"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSLocationWhenInUseUsageDescription": "ShulGo uses your location to find minyanim near you."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
