{
  "name": "shulgo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ShulGo in the macOS menu bar (and the Windows tray): the next minyan near you, with events, mikvaos and zmanim.",
  "author": "ShulGo <info@shulgo.com>",
  "homepage": "https://shulgo.com",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prestart": "npm run sync-core",
    "start": "electron .",
    "predev": "npm run sync-core",
    "dev": "electron . --show --dev",
    "prepack": "npm run sync-core",
    "pack": "electron-builder --dir",
    "predist": "npm run sync-core",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.shulgo.desktop",
    "productName": "ShulGo",
    "files": [
      "src/**/*",
      "assets/**/*",
      "shulgo-core/**/*"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSLocationWhenInUseUsageDescription": "ShulGo uses your location to find minyanim near you."
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "ShulGo <info@shulgo.com>",
      "synopsis": "The next minyan near you, in the tray",
      "description": "The next minyan near you in the system tray, with upcoming events, mikvaos and today's zmanim, from ShulGo.",
      "desktop": {
        "Name": "ShulGo",
        "GenericName": "Minyan finder",
        "Comment": "The next minyan near you",
        "Keywords": "minyan;shul;synagogue;zmanim;mikvah;davening;",
        "Categories": "Utility;Network;",
        "StartupWMClass": "ShulGo"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ShulGo"
    }
  }
}
